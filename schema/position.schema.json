{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/position.schema.json",
  "title": "Position",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "level",
    "institution",
    "location",
    "url",
    "topics",
    "description",
    "added"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-\\d{4}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 140 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 140 }
    },
    "level": { "enum": ["phd", "postdoc", "permanent"] },
    "institution": { "type": "string", "minLength": 2, "maxLength": 140 },
    "group": { "type": "string", "minLength": 2, "maxLength": 140 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "country"],
      "properties": {
        "city": { "type": "string", "minLength": 1, "maxLength": 100 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "deadline": { "$ref": "#/$defs/date" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "added": { "$ref": "#/$defs/date" },
    "fixture": { "type": "boolean" }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
