---
// The map drawn by every graph view: similar items close together, linked.
// Everything renders at build time; src/scripts/graph.ts only enhances.
// Spec: docs/superpowers/specs/2026-09-28-event-graph-design.md.
import { shortLabel, type Graph } from '../lib/graph';
import { communities, graphPayload, layoutGraph } from '../lib/graph-layout';
import { NODE_RADIUS, shapePath, type Shape } from '../lib/graph-shapes';

interface Props {
  graph: Graph;
  /** Accessible name of the map. */
  label: string;
  /** One entry per shape in use. */
  legend: ReadonlyArray<readonly [Shape, string]>;
  /** When set, undimmed nodes get a halo and the legend explains it with this. */
  currentNote?: string;
}

const { graph, label, legend, currentNote } = Astro.props;
const layout = layoutGraph(graph);
const at = new Map(layout.positions.map((p) => [p.id, p]));
// Links between clusters are drawn faint, so the clusters themselves read first.
const cluster = new Map(
  communities(
    graph.nodes.map((n) => n.id),
    graph.edges,
  ).map((c, i) => [graph.nodes[i]!.id, c]),
);
---

{graph.nodes.length > 0 && (
  <>
    <figure class="graph">
      <svg
        id="graph"
        class="graph__svg"
        viewBox={layout.viewBox.join(' ')}
        role="group"
        aria-label={label}
      >
        <g class="graph__edges" aria-hidden="true">
          {graph.edges.map((e) => {
            const a = at.get(e.source)!;
            const b = at.get(e.target)!;
            return (
              <line
                class="graph__edge"
                data-source={e.source}
                data-target={e.target}
                x1={a.x}
                y1={a.y}
                x2={b.x}
                y2={b.y}
                stroke-opacity={(cluster.get(e.source) === cluster.get(e.target)
                  ? 0.25 + 0.6 * e.weight
                  : 0.12
                ).toFixed(2)}
              />
            );
          })}
        </g>
        <g class="graph__nodes">
          {graph.nodes.map((n) => {
            const p = at.get(n.id)!;
            const shape = n.shape;
            const label = shortLabel(n.title);
            return (
              <a
                class:list={['graph-node', n.dimmed ? 'graph-node--past' : 'graph-node--current']}
                href={n.href}
                data-id={n.id}
              >
                <title>{n.title}</title>
                <g class="graph-node__body" transform={`translate(${p.x} ${p.y})`}>
                  {currentNote && !n.dimmed && (
                    <circle class="graph-node__halo" r={NODE_RADIUS + 5} />
                  )}
                  <path
                    class:list={[
                      'graph-node__shape',
                      { 'graph-node__shape--ring': shape === 'ring' },
                    ]}
                    d={shapePath(shape)}
                  />
                  <text
                    class="graph-node__label"
                    x={NODE_RADIUS + 7}
                    y="4"
                    data-short={label}
                    data-full={n.title}
                  >
                    {label}
                  </text>
                </g>
              </a>
            );
          })}
        </g>
      </svg>
      <figcaption class="graph__legend">
        <ul>
          {legend.map(([shape, name]) => (
            <li>
              <svg viewBox="-12 -12 24 24" aria-hidden="true">
                <path
                  class:list={[
                    'graph-node__shape',
                    { 'graph-node__shape--ring': shape === 'ring' },
                  ]}
                  d={shapePath(shape)}
                />
              </svg>
              {name}
            </li>
          ))}
          {currentNote && (
            <li>
              <svg viewBox="-16 -16 32 32" aria-hidden="true">
                <circle class="graph-node__halo" r={NODE_RADIUS + 5} />
                <path class="graph-node__shape" d={shapePath('circle')} />
              </svg>
              {currentNote}
            </li>
          )}
        </ul>
      </figcaption>
    </figure>
    <script
      is:inline
      type="application/json"
      id="graph-data"
      set:html={graphPayload(graph, layout)}
    ></script>
  </>
)}

<script>
  import '../scripts/graph.ts';
</script>
